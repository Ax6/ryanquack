{
  "name": "ryanquack",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "TARGET=chrome vite build",
    "build:chrome:mock": "TARGET=chrome MOCK=true vite build",
    "build:firefox": "TARGET=firefox vite build",
    "build:firefox:mock": "TARGET=firefox MOCK=true vite build",
    "build:safari": "TARGET=safari vite build",
    "build:safari:mock": "TARGET=safari MOCK=true vite build",
    "safari:convert": "npm run build:safari && node scripts/safari-project.mjs",
    "safari:sync": "npm run build:safari && node scripts/safari-project.mjs",
    "dev": "vite",
    "mock": "node test-server/server.mjs",
    "icons": "./scripts/generate-icons.sh",
    "test": "vitest run",
    "test:packaging": "npm run build && npm run build:safari && vitest run --dir tests tests/safari-packaging.test.ts",
    "test:e2e": "npm run build:chrome:mock && npm run build:safari:mock && playwright test",
    "typecheck": "tsc --noEmit -p .",
    "package": "npm run build && (cd dist/chrome && zip -r ../chrome-extension.zip . -x '*.DS_Store') && (cd dist/firefox && zip -r ../firefox-extension.zip . -x '*.DS_Store') && git archive -o dist/source-code.zip HEAD"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.33",
    "@types/webextension-polyfill": "^0.12.4",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "bwip-js": "^4.8.0",
    "webextension-polyfill": "^0.12.0"
  }
}
